{
  "title": "Kyverno readonly rootfs audit",
  "uid": "kyverno-readonly-rootfs",
  "tags": [
    "kyverno",
    "module05"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "query": {
          "type": 1,
          "label": "namespace",
          "stream": "{job=\"kubernetes-events\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({job=\"kubernetes-events\"}, namespace)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Violations in range",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({job=\"kubernetes-events\", namespace=~\"$namespace\"} | json | reason=\"PolicyViolation\" | kind!=\"ClusterPolicy\" | msg=~\".*require-readonly-rootfs.*\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Violations by namespace",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (namespace) (count_over_time({job=\"kubernetes-events\", namespace=~\"$namespace\"} | json | reason=\"PolicyViolation\" | kind!=\"ClusterPolicy\" | msg=~\".*require-readonly-rootfs.*\" [$__interval]))",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Violating objects",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (namespace, kind, name) (count_over_time({job=\"kubernetes-events\", namespace=~\"$namespace\"} | json | reason=\"PolicyViolation\" | kind!=\"ClusterPolicy\" | msg=~\".*require-readonly-rootfs.*\" [$__range]))",
          "queryType": "instant",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "events"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "PolicyViolation events",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"kubernetes-events\", namespace=~\"$namespace\"} | json | reason=\"PolicyViolation\" | kind!=\"ClusterPolicy\" | msg=~\".*require-readonly-rootfs.*\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
